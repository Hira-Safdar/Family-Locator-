rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isOwner(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /invite_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.groupId is string;
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /join_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && requestId == request.resource.data.code + '_' + request.auth.uid
        && request.resource.data.groupId is string
        && exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/invite_codes/$(request.resource.data.code)).data.groupId
          == request.resource.data.groupId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow read, update: if false;
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid;

      allow get: if isMember(groupId);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow update: if isOwner(groupId)
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'category', 'memberIds', 'ownerId', 'sos'])
        || (signedIn()
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sos'])
          && (
            request.resource.data.sos.uid == request.auth.uid
            || !request.resource.data.keys().hasAll(['sos'])
          ))
        || (signedIn()
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasOnly(
            resource.data.memberIds.concat([request.auth.uid]))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds'])
          && request.resource.data.inviteCode == resource.data.inviteCode
          && exists(/databases/$(database)/documents/join_requests/$(resource.data.inviteCode + '_' + request.auth.uid)));

      allow delete: if isOwner(groupId);

      match /locations/{uid} {
        allow read: if isMember(groupId);
        allow write: if isMember(groupId) && request.auth.uid == uid;
        allow delete: if isMember(groupId) && request.auth.uid == uid;
      }
    }

    match /alerts/{alertId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isMember(request.resource.data.groupId)
        && request.resource.data.diff({}).affectedKeys()
          .hasOnly(['groupId', 'uid', 'name', 'latitude', 'longitude',
            'createdAt', 'resolvedAt']);
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid
          || isMember(resource.data.groupId));
      allow update: if isMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['resolvedAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}